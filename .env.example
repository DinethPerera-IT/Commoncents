# Copy to .env and change the secrets. Never commit .env.
NODE_ENV=production
PORT=3040

POSTGRES_DB=commoncents
POSTGRES_USER=commoncents
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://commoncents:change-me@db:5432/commoncents

# Seed password every flatmate uses on first login (change it via the app afterwards)
DEFAULT_PASSWORD=change-me

# Set to false only if serving over plain http on the LAN (cookies need it off without TLS)
COOKIE_SECURE=false
